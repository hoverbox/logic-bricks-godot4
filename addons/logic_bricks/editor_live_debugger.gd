@tool
extends EditorDebuggerPlugin

## Editor-side half of Logic Bricks' runtime bridge.
## Running generated scripts send brick activity through EngineDebugger; this
## plugin captures those messages and forwards them to the Logic Bricks panel.

var panel: Control = null


func setup(target_panel: Control) -> void:
	panel = target_panel


func _setup_session(session_id: int) -> void:
	var session := get_session(session_id)
	if session == null:
		return
	# Clear stale flow visualization as soon as a play session ends.
	session.stopped.connect(_on_session_stopped)


func _on_session_stopped() -> void:
	if panel == null or not is_instance_valid(panel):
		return
	if panel.has_method("clear_runtime_live_debug"):
		panel.call_deferred("clear_runtime_live_debug")


func _has_capture(capture: String) -> bool:
	return capture == "logic_bricks"


func _capture(message: String, data: Array, _session_id: int) -> bool:
	if message == "logic_bricks:graph_snapshot_batch":
		if panel == null or not is_instance_valid(panel):
			return true
		if panel.has_method("receive_runtime_graph_snapshot_batch"):
			panel.call_deferred("receive_runtime_graph_snapshot_batch", data)
		return true

	if message == "logic_bricks:brick_activity_batch":
		if panel == null or not is_instance_valid(panel):
			return true
		if panel.has_method("receive_runtime_brick_activity_batch"):
			panel.call_deferred("receive_runtime_brick_activity_batch", data)
		return true

	# Backward compatibility for scripts generated by the first 3.6.0 build.
	if message == "logic_bricks:brick_activity":
		if panel == null or not is_instance_valid(panel):
			return true
		var runtime_path := str(data[0]) if data.size() > 0 else ""
		var brick_id := str(data[1]) if data.size() > 1 else ""
		var state := str(data[2]) if data.size() > 2 else "active"
		if panel.has_method("receive_runtime_brick_activity"):
			panel.call_deferred("receive_runtime_brick_activity", runtime_path, brick_id, state)
		return true
	return false
