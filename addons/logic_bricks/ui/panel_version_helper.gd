@tool
extends RefCounted

## Tells the user when a script's Logic Bricks code was generated by a
## different version of the addon (for example after the addon was updated
## but Apply Code was not pressed again), and lets a teacher list every such
## script in the project (Options > Find Outdated Scripts).

const LogicBrickManager = preload("res://addons/logic_bricks/core/logic_brick_manager.gd")

var panel = null
var notice: Label = null


func setup(target_panel) -> void:
	panel = target_panel


## Adds the toolbar notice next to Apply Code (hidden until needed).
func create_notice(toolbar: Control) -> void:
	notice = Label.new()
	notice.name = "OutdatedCodeNotice"
	notice.add_theme_color_override("font_color", Color(1.0, 0.75, 0.25))
	notice.mouse_filter = Control.MOUSE_FILTER_PASS
	notice.visible = false
	toolbar.add_child(notice)


## Shows or hides the notice for the node the panel is showing.
func refresh_notice() -> void:
	if not is_instance_valid(notice):
		return
	notice.visible = false
	var node: Node = panel.current_node if is_instance_valid(panel.current_node) else null
	if node == null or node.get_script() == null:
		return
	var script_path: String = node.get_script().resource_path
	if script_path.is_empty() or not FileAccess.file_exists(script_path):
		return
	var made_by := LogicBrickManager.generated_by_version(FileAccess.get_file_as_string(script_path))
	var current := LogicBrickManager.addon_version()
	if made_by.is_empty() or made_by == current:
		return
	var older := "an older Logic Bricks" if made_by == LogicBrickManager.UNKNOWN_VERSION else "Logic Bricks %s" % made_by
	notice.text = "⚠ Code from %s" % older
	notice.tooltip_text = "This script's Logic Bricks code was generated by %s, but this project has Logic Bricks %s.\nPress Apply Code to regenerate it with the current version." % [older, current]
	notice.visible = true


## Options > Find Outdated Scripts: every script in the project whose
## Logic Bricks code was not generated by this version.
func find_outdated_scripts() -> Array:
	var current := LogicBrickManager.addon_version()
	var outdated: Array = []
	var dirs: Array[String] = ["res://"]
	while not dirs.is_empty():
		var dir: String = dirs.pop_back()
		for sub in DirAccess.get_directories_at(dir):
			if not sub.begins_with(".") and not (dir == "res://" and sub == "addons"):
				dirs.append(dir.path_join(sub))
		for file in DirAccess.get_files_at(dir):
			if not file.ends_with(".gd"):
				continue
			var path := dir.path_join(file)
			var made_by := LogicBrickManager.generated_by_version(FileAccess.get_file_as_string(path))
			if not made_by.is_empty() and made_by != current:
				outdated.append({"path": path, "version": made_by})
	outdated.sort_custom(func(a, b): return a["path"] < b["path"])
	return outdated


func show_outdated_scripts_report() -> void:
	var current := LogicBrickManager.addon_version()
	var outdated := find_outdated_scripts()
	var text := ""
	if outdated.is_empty():
		text = "Every script with Logic Bricks code was generated by this version (%s)." % current
	else:
		var lines := PackedStringArray()
		for entry in outdated:
			var version: String = "older version" if entry["version"] == LogicBrickManager.UNKNOWN_VERSION else entry["version"]
			lines.append("%s   (%s)" % [entry["path"], version])
		text = "%d script(s) have Logic Bricks code from a different version than this one (%s).\nOpen each scene, select the node and press Apply Code to update it.\n\n%s" % [outdated.size(), current, "\n".join(lines)]
	print("Logic Bricks: " + text)
	var dialog := AcceptDialog.new()
	dialog.title = "Outdated Logic Bricks Scripts"
	dialog.dialog_text = text
	dialog.confirmed.connect(dialog.queue_free)
	dialog.canceled.connect(dialog.queue_free)
	panel._popup_host().add_child(dialog)
	dialog.popup_centered()
